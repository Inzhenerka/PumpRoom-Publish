{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["__tests__/**/*.ts"],
      "env": {
        "vitest": true
      }
    }
  ]
}
