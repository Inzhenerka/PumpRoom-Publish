{
  "name": "pumproom-publish",
  "version": "2.2.0",
  "private": true,
  "description": "GitHub Action for synchronizing tasks with PumpRoom",
  "keywords": [
    "actions"
  ],
  "homepage": "https://github.com/Inzhenerka/PumpRoom-Publish",
  "bugs": {
    "url": "https://github.com/Inzhenerka/PumpRoom-Publish/issues"
  },
  "license": "MIT",
  "author": "Inzhenerka.Tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inzhenerka/PumpRoom-Publish.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/index.cjs",
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prep": "bun run format && bun run check && bun run lint",
    "verify": "bun run format:check && bun run check && bun run lint && bun run build && bun run test",
    "local-action": "local-action . src/main.ts .env",
    "release": "release-it --ci",
    "release:major": "release-it major --ci",
    "release:minor": "release-it minor --ci",
    "release:patch": "release-it patch --ci",
    "release:dry-run": "release-it --ci --dry-run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "release-it": "^21.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "release-it": {
    "git": {
      "requireBranch": "main",
      "requireCommits": true,
      "requireUpstream": true,
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "tagAnnotation": "${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "bun run verify",
        "git diff --exit-code -- dist"
      ],
      "after:release": "node scripts/update-major.js ${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": false
      }
    }
  }
}
