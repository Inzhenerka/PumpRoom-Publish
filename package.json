{
  "name": "pumproom-publish",
  "version": "3.1.1",
  "private": true,
  "description": "GitHub Action for synchronizing tasks with PumpRoom",
  "keywords": [
    "actions"
  ],
  "homepage": "https://github.com/Inzhenerka/PumpRoom-Publish",
  "bugs": {
    "url": "https://github.com/Inzhenerka/PumpRoom-Publish/issues"
  },
  "license": "MIT",
  "author": "Inzhenerka.Tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inzhenerka/PumpRoom-Publish.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/index.cjs",
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun ./node_modules/.bin/vitest run --coverage",
    "test:watch": "bun ./node_modules/.bin/vitest",
    "prep": "bun run format && bun run check && bun run lint",
    "verify": "bun run format:check && bun run check && bun run lint && bun run build && bun run test",
    "local-action": "bun --env-file=.env src/index.ts",
    "release": "bun ./node_modules/.bin/release-it --ci",
    "release:major": "bun run release major",
    "release:minor": "bun run release minor",
    "release:patch": "bun run release patch",
    "release:dry-run": "bun run release --dry-run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "release-it": {
    "git": {
      "requireBranch": "main",
      "requireCommits": true,
      "requireUpstream": true,
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "tagAnnotation": "${version}"
    },
    "npm": false,
    "hooks": {
      "before:init": [
        "bun run verify",
        "git diff --exit-code -- dist"
      ],
      "after:bump": "bun pm version ${version} --no-git-tag-version",
      "after:release": "bun scripts/update-major.js ${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": false
      }
    }
  }
}
